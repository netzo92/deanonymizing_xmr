# Copy locally, set a reachable Monero daemon RPC endpoint, then pass --env-file.
# This VM runs a research collector; it does not install a full Monero daemon.
MONERO_RPC_URL=https://your-monero-rpc.example
BLOCKS_PER_CYCLE=1000
INTERVAL_SECONDS=300
PREDICTION_EVERY=6
# Set PREDICTION_EVERY=0 to collect, verify and export without creating new scores.
# Optional safeguards (defaults also apply when these entries are omitted).
MAX_RINGS=2000000
MIN_FREE_GB=5
RPC_DELAY_MS=100
CONFIRMATIONS=10
# Independent current-chain activity observer; separate database and public feed.
# These optional defaults do not affect the historical research collector.
LIVE_OBSERVER_INTERVAL_SECONDS=120
LIVE_OBSERVER_BLOCKS_PER_CYCLE=12
LIVE_OBSERVER_CONFIRMATIONS=10
